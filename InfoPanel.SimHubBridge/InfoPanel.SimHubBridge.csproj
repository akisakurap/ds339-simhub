<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- InfoPanel 本体 (habibrehmansg/infopanel) は net8.0-windows でビルドされている。
         バージョンが変わっている場合は InfoPanel 本体の TargetFramework に合わせること。 -->
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <UseWPF>false</UseWPF>
    <AssemblyName>InfoPanel.SimHubBridge</AssemblyName>
    <RootNamespace>InfoPanel.SimHubBridge</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!--
      git clone https://github.com/habibrehmansg/infopanel.git ../infopanel 済みの前提。
      InfoPanel 本体は起動時に自前の InfoPanel.Plugins.dll を既にロード済みのため、
      プラグイン側は絶対に同 DLL を出力フォルダにコピーしてはいけない
      (コピーすると型が二重ロードされ IPlugin の型不一致で "Can't find any type
      which implements ICommand" エラーになる)。Private=false / ExcludeAssets=runtime
      でコピーを止め、コンパイル時参照としてのみ使う。
    -->
    <ProjectReference Include="..\..\infopanel\InfoPanel.Plugins\InfoPanel.Plugins.csproj"
                       Private="false" ExcludeAssets="runtime" />
  </ItemGroup>

</Project>
