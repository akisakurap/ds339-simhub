<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>SimHubDS339</AssemblyName>
    <RootNamespace>SimHubDS339</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="LibUsbDotNet" Version="3.0.224" />
    <PackageReference Include="System.Drawing.Common" Version="8.0.10" />
  </ItemGroup>

  <ItemGroup>
    <!-- DS339 プロトコル実装と SimHub クライアントは既存プロジェクトのソースをそのまま共有する -->
    <Compile Include="..\DS339Direct\Ms9132Device.cs" Link="Shared\Ms9132Device.cs" />
    <Compile Include="..\SimHubAida64Bridge\SimHubPropertyClient.cs" Link="Shared\SimHubPropertyClient.cs" />
    <None Include="..\DS339Direct\native\libusb-1.0.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>libusb-1.0.dll</Link>
    </None>
  </ItemGroup>

</Project>
